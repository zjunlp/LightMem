# Supply your own keys using a private environment file.
MEMORY_API_KEY=
MULTIMODAL_DB=./data/multimodal.sqlite3
# DashScope OpenAI-compatible endpoint; set a key and uncomment to enable.
# MULTIMODAL_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MULTIMODAL_EMBEDDING_API_KEY=
MULTIMODAL_EMBEDDING_MODEL=text-embedding-v4
MULTIMODAL_EMBEDDING_FORMAT=singlevector
MULTIMODAL_EMBEDDING_INPUT_MODE=text_only
MULTIMODAL_EMBEDDING_DIMENSIONS=1024
MULTIMODAL_EMBEDDING_CONCURRENCY=4
MULTIMODAL_EMBEDDING_BATCH_SIZE=4
MULTIMODAL_EMBEDDING_IMAGE_BATCH_SIZE=4
MULTIMODAL_EMBEDDING_TIMEOUT=60
MULTIMODAL_SCORING=late
MULTIMODAL_LEXICAL_WEIGHT=0
